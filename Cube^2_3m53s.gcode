; machine_end_gcode = ; ===== OPTION 1: END G-CODE (CONSISTENT IDLE TEMPS) =====\n\nM117 Print Finished! ; Display message: Acknowledge the print is complete\n\n; --- Retraction and Z-Lift ---\nG91 ; Set coordinates to relative mode\nG1 E-2 F2700 ; Retract 2mm to relieve pressure and prevent oozing\nG1 Z+10 F3000 ; Lift nozzle 10mm off the print\n\n; --- Power Management ---\nM117 Cooling Down... ; Display message: Inform user the fans are turning off\nM106 S0 ; Turn off part cooling fan\nM107 ; Turn off fan (alternate for M106 S0)\n\n; --- Parking Move ---\nG90 ; Set coordinates back to absolute mode\nM117 Parking Hotend... ; Display message: Inform user the hotend is moving to the front\nG1 X0 Y220 F6000 ; Move hotend to the front (X0, Y max) for easy print access\n\n; --- Set Idle / Standby Temperatures ---\nM117 Setting Idle Temps... ; Display message: Inform user temps are being lowered but not fully off\n; Note: These temperatures will remain until the next print starts.\nM104 S190 ; Hotend idle temp (prevents cold ooze, speeds next heat-up)\nM140 S50 ; Bed idle temp (prevents thermal shock, quicker warm-up)\n\n; --- Disable Steppers ---\nM117 Motors Off - Ready! ; Display message: Final message indicating it's safe to remove the print\nM84 ; Disable motors (power off steppers)\n\n; ===== END G-CODE =====
