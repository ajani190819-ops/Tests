# Python bytecode, e.g. from `python3 -m py_compile` on the plugin files.
__pycache__/
*.py[cod]

# Runtime state a plugin writes in Orca's plugin storage ("Check setup" reads
# these -- see docs/ORCA-PLUGIN-FACTS.md). They are
# per-machine facts, never shipped, and must not land in the repo.
*_state.json
.install_state.json

# Sliced output used for hand-testing the G-code tools. Keep the captured
# regression fixture under version control.
*.gcode
!tests/fixtures/*.gcode

# Runtime logs created by Orca/plugin tests; never source.
*.log
*.log.*

# Local diagnostic renders and scratch scripts from the Wave geometry probes.
# They are a debugging aid, not source, and must not land in the repo.
/wave-diagnostics/
