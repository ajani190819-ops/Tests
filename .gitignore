# Python bytecode, e.g. from `python3 -m py_compile` on the plugin files.
__pycache__/
*.py[cod]

# Runtime state a plugin writes in Orca's plugin storage ("Check setup" reads
# these -- see docs/ORCA-PLUGIN-FACTS.md). They are
# per-machine facts, never shipped, and must not land in the repo.
*_state.json
.install_state.json

# Sliced output used for hand-testing the G-code tools. Keep the captured
# regression fixture AND the owner's test prints under version control --
# this rule was silently dropping every export uploaded to test-prints/,
# so they only existed in the upload commits and vanished from the working
# tree whenever the sandbox reset.
*.gcode
!tests/fixtures/*.gcode
!test-prints/**/*.gcode

# Runtime logs created by Orca/plugin tests; never source.
*.log
*.log.*

# Local diagnostic renders and scratch scripts from the Wave geometry probes.
# They are a debugging aid, not source, and must not land in the repo.
/wave-diagnostics/
.venv/

# Arena Link is a packaged Electron desktop app. Keep local dependencies,
# installers, and any accidental local environment file out of Git.
/arena-link-windows/node_modules/
/arena-link-windows/dist/
/arena-link-windows/.env
